# Etapa 1: instala dependências de forma reprodutível usando o package-lock.
FROM node:20-alpine AS deps

WORKDIR /app

# Copiamos só manifests primeiro para aproveitar cache quando o código muda.
COPY package*.json ./

RUN npm ci

# Etapa 2: compila o React/Vite para arquivos estáticos.
FROM node:20-alpine AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Vite injeta variáveis VITE_* no bundle durante o build, não em runtime.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

# Etapa 3: imagem final pequena servindo somente o dist com Nginx.
FROM nginx:1.27-alpine AS runner

# Config própria para fallback de SPA e proxy /api para a API interna.
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copia somente o resultado do build; código fonte e devDependencies ficam fora da imagem final.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
